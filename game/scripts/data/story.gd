			{"cmd": "title", "text": "Some days later...", "sub": ""},
			{"cmd": "heal_player"},
			{"cmd": "fade_in", "t": 1.2},
			{"cmd": "say", "expr": "joy", "who": "gm", "text": "Look at you! Colour in your cheeks and fire in your eyes. Now, have you heard of guildleves?"},
