## Cutscenes. Positions are relative to the scene anchor (the player): -z is ahead of the player.
static func cutscenes() -> Dictionary:
	return {
		"opening": [
			{"cmd": "black"}, {"cmd": "letterbox", "on": true},
			{"cmd": "title", "text": "Eorzea", "sub": "Some moons after the Final Days were averted..."},
			{"cmd": "player_anim", "anim": "lie"},
			{"cmd": "spawn", "id": "villager", "look": "villager", "pos": [3.0, 0, -9.0], "face": "player"},
			{"cmd": "cam", "pos": [1.7, 0.8, -0.4], "look": [0, 0.25, 0.7], "fov": 42},
			{"cmd": "fade_in", "t": 2.5},
			{"cmd": "say", "expr": "surprised", "who": "???", "text": "...Hey. Hey! Can you hear me?"},
			{"cmd": "move", "id": "villager", "to": [1.0, 0, -0.6], "t": 2.2, "anim": "run"},
			{"cmd": "anim", "id": "villager", "anim": "kneel"},
			{"cmd": "cam", "pos": [-2.2, 1.1, 1.4], "look": [0.5, 0.4, -0.3], "fov": 45, "t": 1.6},
			{"cmd": "say", "expr": "sorrow", "who": "villager", "text": "Gods, you're battered half to death! And not a stitch on you. Bandits, I'd wager. They've been working this road for weeks."},
			{"cmd": "player_anim", "anim": "sit_up"},
			{"cmd": "say", "expr": "sorrow", "who": "villager", "text": "Easy now, easy. Took your purse, your pack, even your boots. Do you remember anything?"},
			{"cmd": "say", "expr": "sorrow", "who": "<player>", "text": "...Only the road. And the dark."},
			{"cmd": "say", "expr": "fun", "who": "villager", "text": "Well, the road's what you've got left, then. Lean on me. <cityname> is close, and there's folk there who help those down on their luck."},
			{"cmd": "fade_out", "t": 1.5},
			{"cmd": "goto_city"},
			{"cmd": "spawn", "id": "villager", "look": "villager", "pos": [1.2, 0, -1.6], "face": "player"},
			{"cmd": "cam", "pos": [3.5, 1.7, 3.2], "look": [0, 1.2, -0.5], "fov": 50},
			{"cmd": "fade_in", "t": 1.5},
			{"cmd": "say", "expr": "fun", "who": "villager", "text": "Here, a hempen tunic and breeches. Not much, but better than the breeze. Consider it a loan from the Twelve."},
			{"cmd": "equip_starter"},
			{"cmd": "fx", "kind": "flash", "color": "#ffffff"},
			{"cmd": "say", "expr": "joy", "who": "villager", "text": "Go to <guild>. Ask for <gmname>. If anyone can set you back on your feet, it's them."},
			{"cmd": "move", "id": "villager", "to": [6.0, 0, 6.0], "t": 2.5, "anim": "walk"},
			{"cmd": "despawn", "id": "villager"},
			{"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"msq1_end": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "gm", "look": "<gm>", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "cam", "pos": [1.6, 1.55, 0.8], "look": [0, 1.4, -2.0], "fov": 42},
			{"cmd": "say", "expr": "fun", "who": "gm", "text": "Another one dragged in off the road. Sit, sit. You look like a wet cat that lost an argument with a coeurl."},
			{"cmd": "say", "expr": "angry", "who": "gm", "text": "The Gilded Fangs, was it? They've grown bold since the skies went quiet. Everyone's so busy celebrating the end of the end that no one's watching the roads."},
			{"cmd": "say", "expr": "neutral", "who": "gm", "text": "Rest at <inn>. On the guild's tab, mind. When you can lift a blade without wincing, come find me. There's always work for an adventurer."},
			{"cmd": "fade_out", "t": 1.2},
			{"cmd": "title", "text": "Some days later...", "sub": ""},
			{"cmd": "heal_player"},
			{"cmd": "fade_in", "t": 1.2},
			{"cmd": "say", "expr": "joy", "who": "gm", "text": "Look at you! Colour in your cheeks and fire in your eyes. Now, have you heard of guildleves?"},
			{"cmd": "say", "expr": "neutral", "who": "gm", "text": "Contracts. Culling, gathering, guarding, escorts. Honest coin for honest sweat. Take them from the levemete board whenever you like."},
			{"cmd": "say", "expr": "fun", "who": "gm", "text": "And eat before you head out. Main, side and a drink, from the kitchen. Hunters who fight hungry end up as somebody else's supper."},
			{"cmd": "unlock", "what": "leves"},
			{"cmd": "despawn", "id": "gm"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"msq2_start": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "gm", "look": "<gm>", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "cam", "pos": [-1.4, 1.5, 0.9], "look": [0, 1.4, -2.0], "fov": 42},
			{"cmd": "say", "expr": "neutral", "who": "gm", "text": "First real contract, then. Beasts have been harrying carts just outside the walls. Show me you remember which end of your weapon goes in the monster."},
			{"cmd": "despawn", "id": "gm"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"msq2_end": [
			{"cmd": "title", "text": "Contract Fulfilled", "sub": "The road is a little safer."}, {"cmd": "end"},
		],
		"twins_cameo": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "beast", "look": "monster:<small_big>", "pos": [0, 0, -10.0], "face": "player"},
			{"cmd": "cam", "pos": [2.5, 1.0, 1.5], "look": [0, 1.2, -10.0], "fov": 48},
			{"cmd": "say", "expr": "surprised", "who": "Refugee", "text": "The city walls! We made it! Wait, what's that?!"},
