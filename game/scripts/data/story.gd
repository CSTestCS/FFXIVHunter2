			{"cmd": "fx", "kind": "burst", "at": "thancred", "color": "#c8d8ff"}, {"cmd": "fx", "kind": "shake", "amount": 0.6},
			{"cmd": "slowmo", "scale": 0.25, "t": 0.6},
			{"cmd": "cam", "pos": [-1.5, 0.6, -6.5], "look": [0, 1.2, -9.5], "fov": 38},
			{"cmd": "attack", "id": "thancred", "target": "b2", "anim": "slash_r", "color": "#9fc0ff"},
			{"cmd": "attack", "id": "thancred", "target": "b1", "anim": "spin", "color": "#9fc0ff"},
			{"cmd": "attack", "id": "thancred", "target": "b3", "anim": "slash_down", "color": "#ffd080"},
			{"cmd": "slowmo", "scale": 1.0, "t": 0.0},
			{"cmd": "flee", "ids": ["b1", "b2", "b3"]},
			{"cmd": "cam", "pos": [1.8, 1.6, -5.0], "look": [0, 1.5, -9.0], "fov": 42, "t": 1.2},
			{"cmd": "move", "id": "thancred", "to": [0.0, 0, -3.0], "t": 2.0, "anim": "walk"},
			{"cmd": "say", "expr": "fun", "who": "thancred", "text": "They'll run back to their master now, which is rather the point. I've been following that lot for a fortnight."},
