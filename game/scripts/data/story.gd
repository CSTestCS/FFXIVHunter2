		"orrik_intro": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "orrik", "look": "orrik", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "shot", "type": "wide", "on": "orrik", "with": "player"},
			{"cmd": "anim", "id": "orrik", "anim": "talk"},
			{"cmd": "say", "expr": "fun", "who": "orrik", "text": "So you're the one they found bare as a newborn on the road. Hah! Sit down before you fall down."},
			{"cmd": "say", "expr": "neutral", "who": "orrik", "text": "Orrik Stonebrow. Forty years an adventurer, until this knee decided otherwise. Now I sit here and tell youngsters which end of the axe to hold."},
			{"cmd": "say", "expr": "angry", "who": "orrik", "text": "The Gilded Fangs. They started as a handful of deserters after the Final Days. Folk were too busy staring at the sky to notice them growing."},
			{"cmd": "say", "expr": "neutral", "who": "<player>", "text": "They took everything I had. I want it back."},
			{"cmd": "say", "expr": "fun", "who": "orrik", "text": "Good. Anger's a fine whetstone, so long as you don't cut yourself on it. They stash their takings in caches along the road. Start there."},
			{"cmd": "despawn", "id": "orrik"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"ferrant_intro": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "b1", "look": "bandit", "name": "Gilded Fang Thug", "pos": [-2.5, 0, -6.0], "face": "player", "weapon": true},
			{"cmd": "spawn", "id": "b2", "look": "bandit", "pos": [2.5, 0, -6.5], "face": "player", "weapon": true},
			{"cmd": "shot", "type": "low", "on": "b1", "with": "player"},
			{"cmd": "say", "expr": "angry", "who": "b1", "text": "Oi! That's our stash you're pawing through!"},
			{"cmd": "spawn", "id": "ferrant", "look": "ferrant", "pos": [6.0, 0, -2.0], "face": "b2", "weapon": true},
			{"cmd": "cam", "pos": [4.0, 1.2, 1.5], "look": [3.0, 1.2, -4.0], "fov": 48, "t": 0.6},
			{"cmd": "move", "id": "ferrant", "to": [3.0, 0, -5.0], "t": 0.5, "anim": "dash"},
			{"cmd": "attack", "id": "ferrant", "target": "b2", "anim": "slash_r", "color": "#e8f0ff"},
			{"cmd": "flee", "ids": ["b1", "b2"]},
			{"cmd": "say", "expr": "fun", "who": "ferrant", "text": "Hah! Did you see that? One stroke! Ferrant Duvalle, adventurer, at your service. You may thank me now."},
			{"cmd": "say", "expr": "angry", "who": "<player>", "text": "I had them."},
			{"cmd": "say", "expr": "fun", "who": "ferrant", "text": "Of course you did. I shall tell the guild you were most helpful. Do try to keep up, friend. The realm doesn't need saving anymore, but it does need a hero, and I intend to be it."},
			{"cmd": "move", "id": "ferrant", "to": [8.0, 0, 6.0], "t": 2.2, "anim": "run"},
			{"cmd": "despawn", "id": "ferrant"}, {"cmd": "despawn", "id": "b1"}, {"cmd": "despawn", "id": "b2"},
			{"cmd": "say", "expr": "sorrow", "who": "Narration", "text": "Among the cache's contents: a merchant's seal, stamped with the crest of House Marchant."},
			{"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"ysolde_intro": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ysolde", "look": "ysolde", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "shot", "type": "two", "on": "ysolde", "with": "player"},
			{"cmd": "say", "expr": "surprised", "who": "ysolde", "text": "That seal! Where did you find it? That's my father's. It was on the wagon the Fangs took last month."},
			{"cmd": "say", "expr": "sorrow", "who": "ysolde", "text": "He wasn't hurt, thank the Twelve, but he hasn't been the same. He won't send another caravan out, and without caravans we have nothing."},
			{"cmd": "say", "expr": "neutral", "who": "ysolde", "text": "So I'll take one out myself. I'm Ysolde. Ysolde Marchant. And I need someone who isn't afraid of the Fangs."},
			{"cmd": "say", "expr": "neutral", "who": "<player>", "text": "I'm plenty afraid. But I'll go."},
			{"cmd": "say", "expr": "joy", "who": "ysolde", "text": "Honest! I like that. We leave when you're ready. Speak to <gmname> and we'll make it official."},
			{"cmd": "despawn", "id": "ysolde"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"caravan_depart": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ysolde", "look": "ysolde", "pos": [1.6, 0, -1.4], "face": "player", "weapon": true},
			{"cmd": "shot", "type": "wide", "on": "ysolde", "with": "player"},
			{"cmd": "say", "expr": "neutral", "who": "ysolde", "text": "The wagon's loaded. Grain, cloth, and a crate of my mother's pickles that I'm told is worth more than the rest combined."},
			{"cmd": "say", "expr": "fun", "who": "ysolde", "text": "I can shoot a bow, so don't think you're carrying me. Just keep the wagon moving and the Fangs off it."},
			{"cmd": "despawn", "id": "ysolde"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"caravan_arrives": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ysolde", "look": "ysolde", "pos": [0, 0, -2.2], "face": "player"},
			{"cmd": "anim", "id": "ysolde", "anim": "cheer"},
			{"cmd": "say", "expr": "joy", "who": "ysolde", "text": "We made it! Every crate, every wheel! Father's going to cry. Actually cry!"},
			{"cmd": "say", "expr": "neutral", "who": "ysolde", "text": "Did you see their armbands, though? Gold thread. Bandits don't spend coin on finery unless someone's paying them very well."},
			{"cmd": "say", "expr": "fun", "who": "ysolde", "text": "Here's your share. And you've a friend in House Marchant now, for whatever that's worth."},
			{"cmd": "despawn", "id": "ysolde"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"wager_start": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ferrant", "look": "ferrant", "pos": [1.4, 0, -2.0], "face": "player", "weapon": true},
			{"cmd": "spawn", "id": "gm", "look": "<gm>", "pos": [-1.2, 0, -2.4], "face": "player"},
			{"cmd": "shot", "type": "two", "on": "ferrant", "with": "player"},
			{"cmd": "say", "expr": "fun", "who": "ferrant", "text": "Ah, the caravan guard! I hear you kept a wagon of pickles safe. Truly the stuff of ballads."},
			{"cmd": "say", "expr": "angry", "who": "<player>", "text": "And what have you done since?"},
			{"cmd": "say", "expr": "fun", "who": "ferrant", "text": "A wager, then. The road's crawling with beasts again. Whoever culls the most by sundown wins. Loser buys the winner's supper for a week."},
			{"cmd": "say", "expr": "fun", "who": "gm", "text": "Oh, I like this. I'll keep count. And I'll be charging you both for my time."},
			{"cmd": "despawn", "id": "ferrant"}, {"cmd": "despawn", "id": "gm"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"wager_end": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ferrant", "look": "ferrant", "pos": [0.5, 0, -2.4], "face": "player", "weapon": true},
			{"cmd": "anim", "id": "ferrant", "anim": "kneel"},
			{"cmd": "say", "expr": "sorrow", "who": "ferrant", "text": "Six... I also have six. A tie. How utterly unsatisfying."},
			{"cmd": "say", "expr": "neutral", "who": "ferrant", "text": "You fight like someone who has nothing to prove. I fight like someone who has everything to prove. My father thinks adventuring is beneath a Duvalle, you see."},
			{"cmd": "say", "expr": "fun", "who": "<player>", "text": "Then we both buy supper."},
			{"cmd": "say", "expr": "joy", "who": "ferrant", "text": "...Fine. But I choose the tavern."},
			{"cmd": "despawn", "id": "ferrant"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"beast_aftermath": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "tatale", "look": "tatale", "pos": [2.0, 0, -1.5], "face": "player"},
			{"cmd": "shot", "type": "high", "on": "tatale", "with": "player"},
			{"cmd": "say", "expr": "surprised", "who": "tatale", "text": "Don't touch it! Er, sorry. Hello. Tatale Ratale, aetherologist. The guild sent me to see what turned that poor beast mad."},
			{"cmd": "anim", "id": "tatale", "anim": "gather"},
			{"cmd": "say", "expr": "neutral", "who": "tatale", "text": "There. A crystal shard, lodged in its hide. Feel how cold it is? That isn't ice. That's aether. Heavy, sad, wrong aether."},
			{"cmd": "say", "expr": "sorrow", "who": "tatale", "text": "I've only felt this once before, in my teacher's samples from the Final Days. Come to my study in <cityname> when you can. I need to run some tests."},
			{"cmd": "despawn", "id": "tatale"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"tatale_lab": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "tatale", "look": "tatale", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "anim", "id": "tatale", "anim": "talk"},
			{"cmd": "say", "expr": "fun", "who": "tatale", "text": "Welcome to my study! Mind the shelves. And the floor. And that crystal, it bites."},
			{"cmd": "fx", "kind": "nova", "at": "tatale", "color": "#7a3fa8"},
			{"cmd": "say", "expr": "sorrow", "who": "tatale", "text": "The shard is saturated with despair. When the Final Days came, people's hopelessness turned them into beasts. Some of that aether never quite went away."},
			{"cmd": "say", "expr": "angry", "who": "tatale", "text": "But this shard was cut. Shaped. Someone is mining despair-tainted crystal and selling it. And look at this tag on the wrapping."},
			{"cmd": "say", "expr": "angry", "who": "<player>", "text": "Gold thread. The Fangs."},
			{"cmd": "say", "expr": "neutral", "who": "tatale", "text": "Bandits trading in poisoned crystal. Find out who's buying, adventurer. I'll keep testing."},
			{"cmd": "despawn", "id": "tatale"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"camp_warning": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "orrik", "look": "orrik", "pos": [1.5, 0, -2.0], "face": "player", "weapon": true},
			{"cmd": "shot", "type": "low", "on": "orrik", "with": "player"},
			{"cmd": "say", "expr": "angry", "who": "orrik", "text": "Knee or no knee, I'm not letting the Fangs burn this camp. I've a crossbow and a bad temper. You've got the legs."},
			{"cmd": "say", "expr": "neutral", "who": "orrik", "text": "Plant yourself at the barricade. Don't chase. Make them come to you, and make them regret it."},
			{"cmd": "say", "expr": "fun", "who": "<player>", "text": "Just like you taught me."},
			{"cmd": "say", "expr": "joy", "who": "orrik", "text": "Hah! I've taught you nothing. You just listen well. Go!"},
			{"cmd": "despawn", "id": "orrik"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"defense_end": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "orrik", "look": "orrik", "pos": [2.0, 0, -2.5], "face": "player", "weapon": true},
			{"cmd": "spawn", "id": "guard", "look": "guard", "name": "Camp Guard", "pos": [-1.5, 0, -3.0], "face": "player"},
			{"cmd": "shot", "type": "wide", "on": "orrik", "with": "guard"},
			{"cmd": "say", "expr": "joy", "who": "guard", "text": "They broke! They actually broke and ran!"},
			{"cmd": "say", "expr": "fun", "who": "orrik", "text": "Course they did. Bandits fight for coin, and there's no coin in a corpse. Well held, the both of you."},
			{"cmd": "say", "expr": "angry", "who": "orrik", "text": "But I don't like it. That was a proper assault, not a smash-and-grab. Someone's teaching the Fangs to fight like soldiers."},
			{"cmd": "despawn", "id": "orrik"}, {"cmd": "despawn", "id": "guard"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"refugees_start": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ysolde", "look": "ysolde", "pos": [1.5, 0, -2.0], "face": "player", "weapon": true},
			{"cmd": "spawn", "id": "elder", "look": "villager", "name": "Village Elder", "pos": [-1.2, 0, -2.6], "face": "player"},
			{"cmd": "shot", "type": "two", "on": "elder", "with": "player"},
			{"cmd": "say", "expr": "sorrow", "who": "elder", "text": "They came at night. Burned the granary, took the livestock. We've nowhere left but the city."},
			{"cmd": "say", "expr": "angry", "who": "ysolde", "text": "Marchant wagons will carry them. Every last family. And the Fangs can try to stop us."},
			{"cmd": "say", "expr": "neutral", "who": "<player>", "text": "Stay close to the wagon. I'll handle the rest."},
			{"cmd": "despawn", "id": "ysolde"}, {"cmd": "despawn", "id": "elder"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"ledger_found": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "shot", "type": "closeup", "on": "player"},
			{"cmd": "say", "expr": "surprised", "who": "<player>", "text": "Shipments of crystal, every week... all to buyers in robes. 'For the Choir.' Payment in gold, and in something called 'the Hymn'."},
			{"cmd": "say", "expr": "neutral", "who": "Narration", "text": "The ledger's final pages name the Fangs' stronghold: a camp in Central Thanalan, and the name of the man who runs it. Gerolt."},
			{"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"ferrant_alone": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "gm", "look": "<gm>", "pos": [0, 0, -2.0], "face": "player"},
			{"cmd": "say", "expr": "angry", "who": "gm", "text": "That fool Duvalle! He read the ledgers over my shoulder and went haring off after the Fangs' guard-beast. Alone!"},
			{"cmd": "say", "expr": "sorrow", "who": "gm", "text": "It's a coeurl, trained and fed on that tainted crystal. He'll get himself killed trying to prove something to his father."},
			{"cmd": "say", "expr": "neutral", "who": "<player>", "text": "I'll bring him back."},
			{"cmd": "despawn", "id": "gm"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
		],
		"ferrant_saved": [
			{"cmd": "letterbox", "on": true},
			{"cmd": "spawn", "id": "ferrant", "look": "ferrant", "pos": [1.0, 0, -2.0], "face": "player", "weapon": true},
			{"cmd": "anim", "id": "ferrant", "anim": "sit"},
			{"cmd": "shot", "type": "high", "on": "ferrant", "with": "player"},
