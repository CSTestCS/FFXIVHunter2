			{"cmd": "say", "expr": "sorrow", "who": "tatale", "text": "The Unsung. I've heard whispers. They're mostly people who lost everything in the Final Days and never found a reason to hope again."},
			{"cmd": "say", "expr": "sorrow", "who": "tatale", "text": "They believe the song of despair that nearly ended the world was the star's true voice. That it was interrupted, not defeated."},
			{"cmd": "say", "expr": "angry", "who": "orrik", "text": "And they want to finish it. Gods preserve us from grieving fools with a cause."},
			{"cmd": "say", "expr": "neutral", "who": "tatale", "text": "The tainted crystal comes from Mor Dhona, near Silvertear Lake. If you bring me samples, I can learn what they're building."},
			{"cmd": "title", "text": "Act III", "sub": "The Unsung"},
			{"cmd": "despawn", "id": "tatale"}, {"cmd": "despawn", "id": "orrik"}, {"cmd": "letterbox", "on": false}, {"cmd": "end"},
